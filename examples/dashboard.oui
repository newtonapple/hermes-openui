root = Stack([header, kpis, load, tabs, note, actions])
header = Text("Cluster status", "title")
kpis = Stack([m1, m2, m3], "row", "m", true)
m1 = Metric("GPU util", "87%", "+4% vs 1h ago", "warn")
m2 = Metric("Nodes up", "4 / 4", "all healthy", "good")
m3 = Metric("Queue", "12", "-3", "good")
load = Card([chart], "Load by node")
chart = BarChart(["spark-1", "spark-2", "spark-3", "spark-4"], [91, 84, 77, 62], null, "%")
tabs = Tabs([t1, t2])
t1 = TabItem("Models", [tbl])
tbl = Table(["Model", "Node", "tok/s"], [["qwen3-32b", "spark-1", 41], ["llama-3.3-70b", "spark-2", 18]])
t2 = TabItem("Notes", [Text("Nightly backup finished at 02:14.", "muted")])
note = Callout("spark-4 is running below its power cap.", "warn")
actions = Stack([b1, b2], "row", "s")
b1 = Button("Show slowest requests", @ToAssistant("Show the 10 slowest vLLM requests from the last hour"))
b2 = Button("Restart spark-4", @ToAssistant("Restart the vllm service on spark-4 and confirm it is healthy"))
