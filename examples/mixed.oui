root = Stack([title, kpis, tabs])
title = Text("Pack test: all four packs in one widget", "title")
kpis = Stack([m1, m2], "row", "m", true)
m1 = Metric("Packs embedded", "core + 4", "charts, diagrams, map, text", "good")
m2 = Metric("Page limit", "480 KB", "worst case ~390 KB", "neutral")
tabs = Tabs([t1, t2, t3, t4])
t1 = TabItem("Chart", [Card([lc], "Throughput (charts pack)")])
lc = LineChart(["Mon", "Tue", "Wed", "Thu"], [Series("tok/s", [120, 135, 128, 150])])
t2 = TabItem("Pipeline", [pipe])
pipe = Dag([DagNode("a", "Extract", "done"), DagNode("b", "Train", "running"), DagNode("c", "Publish", "pending")], [["a", "b"], ["b", "c"]], "LR", "Diagrams pack")
t3 = TabItem("Map", [sites])
sites = GeoMap([GeoPoint("Berlin", 52.5, 13.4, "good"), GeoPoint("Tokyo", 35.7, 139.7, "info")], [["Berlin", "Tokyo"]], "Map pack")
t4 = TabItem("Text", [notes, hi])
notes = Markdown("**Markdown** from the `text` pack.\n\n- one\n- two")
hi = Button("Say hi", @ToAssistant("Pack test: reply with the single word hi"))
