root = Stack([title, kpis, trend, split])
title = Text("Inference traffic (sample data)", "title")
kpis = Stack([m1, m2, m3], "row", "m", true)
m1 = Metric("Requests / min", "1,284", "+6% vs last hour", "good")
m2 = Metric("p95 latency", "840 ms", "+90 ms", "warn")
m3 = Metric("Errors", "0.3%", "-0.1 pt", "good")
trend = Card([tabs], "Throughput by node (tokens/s)")
tabs = Tabs([tLine, tArea, tRadar])
tLine = TabItem("Line", [line])
line = LineChart(["00:00", "04:00", "08:00", "12:00", "16:00", "20:00"], [sA, sB], "natural", null, "tok/s")
sA = Series("node-1", [41, 38, 52, 61, 58, 47])
sB = Series("node-2", [18, 22, 30, 36, 33, 25])
tArea = TabItem("Area", [area])
area = AreaChart(["00:00", "04:00", "08:00", "12:00", "16:00", "20:00"], [sA, sB], "natural")
tRadar = TabItem("Radar", [radar])
radar = RadarChart(["Throughput", "Latency", "Memory", "Uptime", "Cost"], [rA, rB])
rA = Series("node-1", [80, 62, 70, 99, 55])
rB = Series("node-2", [60, 78, 85, 97, 72])
split = Card([pie], "Traffic by model")
pie = PieChart(["qwen3-32b", "llama-3.3-70b", "embeddings", "other"], [46, 31, 17, 6])
