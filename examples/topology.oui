root = Stack([title, legend, banner, tabs])
title = Text("Homelab network (illustrative sample)", "title")
legend = Text("Node colour is health: done = up, running = busy, failed = down. Arrows point away from the internet.", "muted")
banner = Callout("spark-3 is unreachable: its uplink goes through Rack switch B, which is degraded.", "warn")
tabs = Tabs([tTopo, tLinks, tAct])
tTopo = TabItem("Topology", [graph])
tLinks = TabItem("Links", [links])
tAct = TabItem("Actions", [diag, fix])
graph = Dag([inet, fw, core, swA, swB, ap, s1, s2, s3, nas, pg], [["inet", "fw"], ["fw", "core"], ["core", "swA"], ["core", "swB"], ["core", "ap"], ["swA", "s1"], ["swA", "s2"], ["swB", "s3"], ["swB", "nas"], ["swA", "pg"], ["swB", "pg"]], null, "North-south path from the internet")
inet = DagNode("inet", "Internet", "done")
fw = DagNode("fw", "Firewall", "done")
core = DagNode("core", "Core switch", "done")
swA = DagNode("swA", "Rack switch A", "done")
swB = DagNode("swB", "Rack switch B", "running")
ap = DagNode("ap", "Wi-Fi AP", "done")
s1 = DagNode("s1", "spark-1", "running")
s2 = DagNode("s2", "spark-2", "done")
s3 = DagNode("s3", "spark-3", "failed")
nas = DagNode("nas", "NAS", "done")
pg = DagNode("pg", "Postgres", "done")
links = Table(["From", "To", "Link", "State"], [["Internet", "Firewall", "1 GbE", "up"], ["Firewall", "Core switch", "10 GbE", "up"], ["Core switch", "Rack switch A", "25 GbE", "up"], ["Core switch", "Rack switch B", "25 GbE", "errors"], ["Core switch", "Wi-Fi AP", "2.5 GbE", "up"], ["Rack switch A", "spark-1", "10 GbE", "up"], ["Rack switch A", "spark-2", "10 GbE", "up"], ["Rack switch B", "spark-3", "10 GbE", "down"], ["Rack switch B", "NAS", "10 GbE", "up"], ["Rack switch A / B", "Postgres", "2 x 10 GbE", "up"]])
diag = Button("Diagnose spark-3", @ToAssistant("Diagnose why spark-3 is unreachable: check Rack switch B port errors first"))
fix = Button("Show link error counters", @ToAssistant("Show the interface error counters for the Core switch to Rack switch B uplink"))
