root = Stack([map])
map = InfraMap([zClients, zEdge, zApp, zData], [l1, l2, l3, l4, l5, l6, l7, l8], "Web platform (illustrative sample)")
zClients = InfraZone("Clients", [browser, mobile])
browser = InfraNode("browser", "Browser", "client", "up")
mobile = InfraNode("mobile", "Mobile app", "client", "up")
zEdge = InfraZone("Edge", [lb])
lb = InfraNode("lb", "Load balancer", "gateway", "up", "HTTPS :443")
zApp = InfraZone("Application", [web1, web2, worker])
web1 = InfraNode("web-1", "web-1", "service", "up", "nginx")
web2 = InfraNode("web-2", "web-2", "service", "degraded", "slow responses")
worker = InfraNode("worker", "worker", "service", "up", "background jobs")
zData = InfraZone("Data", [pg, cache, files])
pg = InfraNode("pg", "Postgres", "database", "up", ":5432")
cache = InfraNode("cache", "Cache", "database", "up", "in memory")
files = InfraNode("files", "Object storage", "storage", "unknown")
l1 = InfraLink("browser", "lb", "HTTPS")
l2 = InfraLink("mobile", "lb", "HTTPS")
l3 = InfraLink("lb", "web-1", "route")
l4 = InfraLink("lb", "web-2", "route")
l5 = InfraLink("lb", "worker", "enqueue")
l6 = InfraLink("web-1", "pg", "SQL")
l7 = InfraLink("cache", "web-1", "expire", "dashed")
l8 = InfraLink("pg", "files", "backup", "dashed")
