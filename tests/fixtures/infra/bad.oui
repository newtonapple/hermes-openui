root = Stack([map])
map = InfraMap([zApp, zDb], [l1, l2], "Broken sample: a link names an id that does not exist")
zApp = InfraZone("App", [web, api])
web = InfraNode("web", "Web app", "client")
api = InfraNode("api", "API", "service", "up")
zDb = InfraZone("Database", [pg])
pg = InfraNode("pg", "Postgres", "database", "up")
l1 = InfraLink("web", "api", "HTTPS")
l2 = InfraLink("api", "postgres", "SQL")
