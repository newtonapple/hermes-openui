root = Stack([map])
map = InfraMap([zEdge, zServices, zData], [l1, l2, l3, l4, l5, l6, l7, l8], "Request path, top to bottom (illustrative sample)", "TB")
zEdge = InfraZone("Edge", [browser, edge], "info")
browser = InfraNode("browser", "Browser", "client", "up")
edge = InfraNode("edge", "Reverse proxy", "gateway", "up", "TLS")
zServices = InfraZone("Services", [api, queue, worker], "warn")
api = InfraNode("api", "API", "service", "up", "REST :8080")
queue = InfraNode("queue", "Job queue", "queue", "up")
worker = InfraNode("worker", "Worker", "service", "degraded", "2 of 3 replicas")
zData = InfraZone("Data", [pg, objects, backup])
pg = InfraNode("pg", "Postgres", "database", "up")
objects = InfraNode("objects", "Object storage", "storage", "up")
backup = InfraNode("backup", "Cloud backup", "cloud", "unknown")
l1 = InfraLink("browser", "edge", "HTTPS")
l2 = InfraLink("edge", "api", "route")
l3 = InfraLink("api", "queue", "enqueue")
l4 = InfraLink("queue", "worker", "pull")
l5 = InfraLink("api", "pg", "SQL")
l6 = InfraLink("worker", "objects", "files")
l7 = InfraLink("edge", "objects", "assets", "dashed")
l8 = InfraLink("pg", "backup", "dump", "dashed")
